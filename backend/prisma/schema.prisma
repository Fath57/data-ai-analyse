// Prisma Schema for IA Data Insight - NGO Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String?   // Nullable for OAuth users
  name          String?
  avatar        String?
  organization  String?   // NGO name
  role          UserRole  @default(USER)

  // OAuth fields
  googleId      String?   @unique
  provider      AuthProvider?

  // Metadata
  isActive      Boolean   @default(true)
  isVerified    Boolean   @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  projects      Project[]
  queries       Query[]
  refreshTokens RefreshToken[]

  @@map("users")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum AuthProvider {
  GOOGLE
  LOCAL
}

// Refresh Token for JWT
model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

// Project/Workspace model
model Project {
  id          String        @id @default(uuid())
  name        String
  description String?

  // Owner
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Settings
  isPublic    Boolean       @default(false)
  shareToken  String?       @unique // For public sharing

  // Metadata
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  datasets    Dataset[]
  queries     Query[]

  @@map("projects")
}

// Dataset model (uploaded CSV/Excel)
model Dataset {
  id            String      @id @default(uuid())
  name          String
  originalName  String      // Original filename
  fileType      FileType
  fileSize      Int         // Size in bytes
  filePath      String      // Storage path (S3 or local)

  // Project relation
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Data schema (stored as JSON)
  schema        Json?       // Column names, types, sample data
  rowCount      Int?
  columnCount   Int?

  // Processing status
  status        DatasetStatus @default(UPLOADING)
  errorMessage  String?

  // Metadata
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  queries       Query[]

  @@map("datasets")
}

enum FileType {
  CSV
  XLSX
  XLS
}

enum DatasetStatus {
  UPLOADING
  PROCESSING
  READY
  ERROR
}

// Query/Analysis model
model Query {
  id          String      @id @default(uuid())

  // User query
  question    String      // Natural language question

  // Project and Dataset
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  datasetId   String?
  dataset     Dataset?    @relation(fields: [datasetId], references: [id], onDelete: SetNull)

  // User
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  // AI Response
  aiResponse  Json?       // Structured response from AI
  sqlQuery    String?     // Generated SQL (if applicable)

  // Visualization
  chartType   ChartType?
  chartConfig Json?       // Chart configuration

  // Results
  results     Json?       // Query results data

  // Metadata
  executionTime Int?      // Execution time in ms
  status      QueryStatus @default(PENDING)
  errorMessage String?

  createdAt   DateTime    @default(now())

  @@map("queries")
}

enum ChartType {
  BAR
  LINE
  PIE
  DOUGHNUT
  SCATTER
  TABLE
  MAP
  AREA
  RADAR
}

enum QueryStatus {
  PENDING
  PROCESSING
  SUCCESS
  ERROR
}

// NGO-Specific Template model
model Template {
  id          String      @id @default(uuid())
  name        String
  description String
  category    TemplateCategory

  // Template query
  query       String      // Pre-defined query pattern
  chartType   ChartType

  // Configuration
  config      Json?       // Default configuration

  // Usage tracking
  usageCount  Int         @default(0)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("templates")
}

enum TemplateCategory {
  DONOR_ANALYSIS
  BUDGET_TRACKING
  IMPACT_METRICS
  GEOGRAPHIC_DISTRIBUTION
  TREND_ANALYSIS
  BENEFICIARY_TRACKING
  PROJECT_MONITORING
  FUNDRAISING_ANALYTICS
}
